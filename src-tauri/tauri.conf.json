{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KASA PRO V19 · BY İLHAN EŞİN",
  "version": "19.24.0",
  "identifier": "com.kasapro.v19",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KASA PRO V19",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob: https: http://localhost:1420; connect-src 'self' https: wss: http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
